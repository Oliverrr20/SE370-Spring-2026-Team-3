<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="hospital_room_manager.PatientInfoController"
            styleClass="page-background">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="top-nav">
            <Label text="Hospital Room Manager" styleClass="nav-title"/>
            <Button text="Room Dashboard" onAction="#goToDashboard"/>
            <Button text="Assign Patient" onAction="#goToAssignment"/>
            <Button text="Patient Info"   onAction="#goToPatientInfo"/>
            <Button text="Logout"         onAction="#logout"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="15" styleClass="form-card">
            <Label text="Patient Information" styleClass="main-title"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="Search by name, phone, email, room..." prefWidth="400"/>
                <Button text="Search" onAction="#searchPatients" styleClass="primary-button"/>
                <Button text="Clear"  onAction="#clearSearch"/>
            </HBox>

            <TableView fx:id="patientTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="nameColumn"      text="Name"           prefWidth="160"/>
                    <TableColumn fx:id="genderColumn"    text="Gender"         prefWidth="80"/>
                    <TableColumn fx:id="phoneColumn"     text="Phone"          prefWidth="130"/>
                    <TableColumn fx:id="emailColumn"     text="Email"          prefWidth="190"/>
                    <TableColumn fx:id="admissionColumn" text="Admission Date" prefWidth="130"/>
                    <TableColumn fx:id="roomColumn"      text="Room"           prefWidth="110"/>
                </columns>
            </TableView>

            <Label fx:id="selectedPatientLabel" text="Patient Selected: None" styleClass="info-label"/>
        </VBox>
    </center>

    <padding>
        <Insets top="20" right="25" bottom="25" left="25"/>
    </padding>
</BorderPane>
